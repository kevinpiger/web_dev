{
  "$defs": {
    "CorrectionSuggestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "diff_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diff Id"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "instruction": {
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        }
      },
      "required": [
        "id",
        "target",
        "instruction"
      ],
      "title": "CorrectionSuggestion",
      "type": "object"
    },
    "DrawerChange": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "suggestion_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion Id"
        }
      },
      "required": [
        "target",
        "description"
      ],
      "title": "DrawerChange",
      "type": "object"
    },
    "DrawerOutput": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "TIMING",
            "REGISTER"
          ],
          "title": "Type",
          "type": "string"
        },
        "content_type": {
          "const": "WAVEDROM",
          "default": "WAVEDROM",
          "title": "Content Type",
          "type": "string"
        },
        "content": {
          "additionalProperties": true,
          "title": "Content",
          "type": "object"
        },
        "render_artifact_id": {
          "format": "uuid",
          "title": "Render Artifact Id",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/DrawerChange"
          },
          "title": "Changes",
          "type": "array"
        }
      },
      "required": [
        "type",
        "content",
        "render_artifact_id",
        "summary"
      ],
      "title": "DrawerOutput",
      "type": "object"
    },
    "DrawerStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "input_step_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Step Id"
        },
        "status": {
          "enum": [
            "PENDING",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED"
          ],
          "title": "Status",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "DRAWER",
          "title": "Type",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/DrawerOutput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "sequence",
        "input_step_id",
        "status",
        "created_at",
        "type"
      ],
      "title": "DrawerStep",
      "type": "object"
    },
    "StepError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "StepError",
      "type": "object"
    },
    "VerificationDifference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "MISSING",
            "EXTRA",
            "VALUE",
            "TIMING",
            "LAYOUT",
            "OTHER"
          ],
          "title": "Category",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "actual": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        }
      },
      "required": [
        "id",
        "category",
        "target",
        "description"
      ],
      "title": "VerificationDifference",
      "type": "object"
    },
    "VerifyOutput": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "enum": [
            "TRUE",
            "PARTIAL",
            "FALSE"
          ],
          "title": "Match",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "checked_at_display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At Display"
        },
        "diff_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diff Count"
        },
        "diffs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/VerificationDifference"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diffs"
        },
        "suggestions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CorrectionSuggestion"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestions"
        }
      },
      "required": [
        "match",
        "summary"
      ],
      "title": "VerifyOutput",
      "type": "object"
    },
    "VerifyStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "input_step_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Step Id"
        },
        "status": {
          "enum": [
            "PENDING",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED"
          ],
          "title": "Status",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "VERIFY",
          "title": "Type",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerifyOutput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "sequence",
        "input_step_id",
        "status",
        "created_at",
        "type"
      ],
      "title": "VerifyStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "steps": {
      "items": {
        "discriminator": {
          "mapping": {
            "DRAWER": "#/$defs/DrawerStep",
            "VERIFY": "#/$defs/VerifyStep"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/DrawerStep"
          },
          {
            "$ref": "#/$defs/VerifyStep"
          }
        ]
      },
      "title": "Steps",
      "type": "array"
    },
    "final_drawer_step_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Drawer Step Id"
    },
    "final_verify_step_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Verify Step Id"
    }
  },
  "title": "ResultFlow",
  "type": "object"
}
